# Mode Arena Environment Configuration
GCP_PROJECT_ID="your-argolis-project-id"
GCP_REGION="us-central1"

# Database Configuration (Cloud SQL PostgreSQL)
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/mode_arena"

# BigQuery Dataset
BIGQUERY_DATASET="mode_arena_telemetry"

# Model Armor Settings
MODEL_ARMOR_PROJECT_ID="your-argolis-project-id"
MODEL_ARMOR_TEMPLATE="projects/your-argolis-project-id/locations/us-central1/templates/default-template"

# Demo Mode Settings
DEMO_MAX_INPUT_TOKENS="16384"
DEMO_MAX_OUTPUT_TOKENS="2048"
DEMO_DAILY_BUDGET_USD="15.00"
